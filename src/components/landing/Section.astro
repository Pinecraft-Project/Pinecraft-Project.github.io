---
interface Props {
	title?: string;
	subtitle?: string;
	class?: string;
	id?: string;
	style?: string;
}
const { title, subtitle, class: cls = "", id, style } = Astro.props;
---

<section {id} {style} class:list={["py-20 px-6", cls]}>
	<div class="max-w-6xl mx-auto">
		{
			(title || subtitle) && (
				<div class="text-center mb-14">
					{title && (
						<h2 class="text-3xl md:text-4xl font-bold text-white mb-3 tracking-tight">{title}</h2>
					)}
					{subtitle && (
						<p class="text-textColor/60 max-w-xl mx-auto text-base">{subtitle}</p>
					)}
				</div>
			)
		}
		<slot />
	</div>
</section>
