---
import { landingContent } from "@/data/landing";
import { siteConfig } from "@/site-config";

const heroContent = landingContent.hero;
const serverAddress = siteConfig.server.address;
---

<section
	class="relative min-h-screen flex items-center justify-center overflow-hidden"
	id="hero"
	aria-label="Hero"
>
	<!-- Deep background gradient - night forest -->
	<div
		class="absolute inset-0"
		style="background: linear-gradient(160deg, #071020 0%, #0f1720 40%, #061a0e 100%);"
	></div>

	<!-- Pixel grid overlay -->
	<div class="absolute inset-0 pixel-grid opacity-100"></div>

	<!-- Distant glow -->
	<div
		class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[80vw] h-[40vh] rounded-full blur-3xl opacity-15"
		style="background: radial-gradient(ellipse, #4ade80 0%, transparent 70%);"
	></div>
	<div
		class="absolute top-0 right-0 w-[40vw] h-[40vh] rounded-full blur-3xl opacity-10"
		style="background: radial-gradient(ellipse, #22c55e 0%, transparent 70%);"
	></div>

	<!-- Content -->
	<div class="relative z-10 text-center px-6 max-w-4xl mx-auto">
		<h1 class="text-6xl md:text-8xl font-bold text-white mb-4 tracking-tight leading-none">
			{heroContent.brandPrefix}<span class="text-accent">{heroContent.brandAccent}</span>
		</h1>

		<p class="text-xl md:text-2xl text-textColor/70 mb-10 leading-relaxed max-w-2xl mx-auto">
			{heroContent.subtitle}
		</p>

		<!-- IP Copy -->
		<div class="flex items-center justify-center mb-10">
			<button
				id="copy-ip-btn"
				class="group flex items-center gap-3 px-5 py-2.5 rounded-xl border border-accent/20 text-accent/80 font-mono text-sm hover:border-accent/50 hover:text-accent hover:bg-accent/5 transition-all duration-200"
				aria-label={serverAddress}
				title={heroContent.copyTitle}
				data-ip={serverAddress}
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
					<path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 0 1-3-3m3 3a3 3 0 1 0 0 6h13.5a3 3 0 1 0 0-6m-16.5-3a3 3 0 0 1 3-3h13.5a3 3 0 0 1 3 3m-19.5 0a4.5 4.5 0 0 1 .9-2.7L5.737 5.1a3.375 3.375 0 0 1 2.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 0 1 .9 2.7m0 0a3 3 0 0 1-3 3m0 3h.008v.008h-.008v-.008Zm0-6h.008v.008h-.008v-.008Zm-3 6h.008v.008h-.008v-.008Zm0-6h.008v.008h-.008v-.008Z" />
				</svg>
				<span id="ip-label">{serverAddress}</span>
				<svg id="copy-icon" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 opacity-50 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
					<path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
				</svg>
			</button>
		</div>

		<!-- CTA Buttons -->
		<div class="flex flex-col sm:flex-row gap-4 justify-center" id="join">
			<a
				href={heroContent.primaryCta.href}
				class="px-8 py-3.5 rounded-xl font-bold text-[#0f1720] bg-accent hover:bg-accent/90 transition-all duration-200 shadow-lg shadow-accent/20 hover:shadow-accent/30 hover:scale-105 text-sm"
			>
				{heroContent.primaryCta.label}
			</a>
			<a
				href={heroContent.secondaryCta.href}
				class="px-8 py-3.5 rounded-xl font-semibold text-accent border border-accent/30 hover:border-accent/60 hover:bg-accent/5 transition-all duration-200 text-sm"
			>
				{heroContent.secondaryCta.label}
			</a>
		</div>
	</div>

	<!-- Scroll indicator -->
	<div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 text-textColor/30 text-xs animate-bounce">
		<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
			<path stroke-linecap="round" stroke-linejoin="round" d="m4.5 5.25 7.5 7.5 7.5-7.5m-15 6 7.5 7.5 7.5-7.5" />
		</svg>
	</div>
</section>

<script>
	const btn = document.getElementById("copy-ip-btn")!;
	const label = document.getElementById("ip-label")!;
	btn.addEventListener("click", async () => {
		const ip = btn.dataset.ip!;
		try {
			await navigator.clipboard.writeText(ip);
			label.textContent = "Скопійовано!";
			btn.classList.add("border-accent/60", "text-accent");
			setTimeout(() => {
				label.textContent = ip;
			}, 2000);
		} catch {
			label.textContent = "Помилка копіювання";
		}
	});
</script>
