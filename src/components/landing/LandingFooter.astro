---
import FooterCommunity from "@/components/landing/FooterCommunity.astro";
import { menuLinks, siteConfig } from "@/site-config";

const year = new Date().getFullYear();
const serverAddress = siteConfig.server.address;
---

<footer
	style="background: rgba(10,16,24,0.95); border-top: 1px solid rgba(74,222,128,0.1);"
	class="mt-auto w-full px-6 py-12"
>
	<div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-10">
		<!-- Brand -->
		<div>
			<div class="flex items-center gap-2 mb-3">
				<img src="/brand/LogoSquare.svg" alt="Pinecraft" class="h-9 w-9" loading="lazy" decoding="async" />
				<span class="text-lg font-bold text-white">Pinecraft</span>
			</div>
			<p class="text-sm text-textColor/70 leading-relaxed">
				Ваніла+ Minecraft сервер, де гравці будують міста, нації та альянси.
			</p>
			<p class="mt-4 text-xs text-textColor/70">
				IP сервера: <span class="text-accent font-mono">{serverAddress}</span>
			</p>
		</div>

		<!-- Links -->
		<div>
			<h3 class="text-sm font-semibold text-white/80 uppercase tracking-widest mb-4">Навігація</h3>
			<nav class="flex flex-col gap-2" aria-label="Footer navigation">
				{
					menuLinks.map((link) => (
						<a
							href={link.path}
							class="text-sm text-textColor/70 hover:text-accent transition-colors w-fit"
						>
							{link.title}
						</a>
					))
				}
			</nav>
		</div>

		<!-- Community -->
		<FooterCommunity />

		<!-- Developer -->
		<div>
			<h3 class="text-sm font-semibold text-white/80 uppercase tracking-widest mb-4">Розробник</h3>
			<div class="flex flex-col gap-3">
				<a
					href="https://github.com/Fulldroper"
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center gap-2 text-sm text-textColor/70 hover:text-accent transition-colors"
				>
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
						<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.6.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v 3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
					</svg>
					GitHub
				</a>
				<a
					href="mailto:full_droper@pm.me"
					class="flex items-center gap-2 text-sm text-textColor/70 hover:text-accent transition-colors"
				>
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
						<path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25H4.5a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5H4.5A2.25 2.25 0 002.25 6.75m19.5 0v-1.5a2.25 2.25 0 00-2.25-2.25H4.5a2.25 2.25 0 00-2.25 2.25v1.5m19.5 0h-15m0 0H4.5m15 0H9" />
					</svg>
					Email
				</a>
			</div>
		</div>
	</div>

	<div class="max-w-6xl mx-auto mt-10 pt-6 border-t border-white/5 flex flex-col sm:flex-row justify-between items-center gap-2 text-xs text-textColor/70">
		<span>
			&copy; {year}
			{siteConfig.authorGithub ? (
				<a href={siteConfig.authorGithub} target="_blank" rel="noopener noreferrer" class="text-textColor/80 hover:text-accent transition-colors">
					{siteConfig.author}
				</a>
			) : (
				<span>{siteConfig.author}</span>
			)}. Не пов'язано з Mojang Studios.
		</span>
		<span>Створено на <a href="https://astro.build" class="text-textColor/80 hover:text-accent transition-colors">Astro</a></span>
	</div>
</footer>
