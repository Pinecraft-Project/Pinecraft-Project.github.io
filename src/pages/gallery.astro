---
import LandingLayout from "@/layouts/Landing.astro";

const rawImages = import.meta.glob<string>(
	"/src/assets/gallery/*.{jpg,jpeg,png,webp,gif}",
	{ eager: true, import: "default" },
);

function normalizeGalleryFilename(filename: string) {
	try {
		return decodeURIComponent(filename);
	} catch {
		return filename;
	}
}

function resolveGallerySrc(src: unknown) {
	if (typeof src === "string") return src;
	if (src && typeof src === "object" && "src" in src) {
		const imageSrc = (src as { src?: unknown }).src;
		return typeof imageSrc === "string" ? imageSrc : "";
	}
	return "";
}

const images = Object.entries(rawImages).map(([path, src]) => {
	const filename = normalizeGalleryFilename(path.split("/").pop() ?? "");
	const caption = filename
		.replace(/\.[^.]+$/, "")
		.replace(/[+_-]/g, " ")
		.replace(/\s+/g, " ")
		.trim()
		.replace(/\b\w/g, (c) => c.toUpperCase());
	return { src: resolveGallerySrc(src), alt: caption, caption };
});

const gradients = [
	"linear-gradient(135deg, #071820 0%, #0a2e14 100%)",
	"linear-gradient(135deg, #0d1f0d 0%, #1a3a1a 100%)",
	"linear-gradient(135deg, #091520 0%, #112233 100%)",
	"linear-gradient(135deg, #0f1720 0%, #1a2f10 100%)",
	"linear-gradient(135deg, #081218 0%, #0f2410 100%)",
	"linear-gradient(135deg, #0a1420 0%, #15350e 100%)",
];
---

<LandingLayout meta={{ title: "Галерея — Pinecraft", description: "Скріншоти спільноти Pinecraft з усього ігрового світу." }}>
	<div class="pt-24 pb-20 px-6 min-h-screen">
		<div class="max-w-6xl mx-auto">
			<div class="mb-12">
				<h1 class="text-4xl font-bold text-white mb-3">Галерея</h1>
				<p class="text-textColor/60 max-w-xl">
					Скріншоти спільноти з усього світу. Надішли свій у
					<a href="https://discord.pinecraft.top/" target="_blank" rel="noopener" class="text-accent hover:underline">#screenshots</a>
					у Discord.
				</p>
			</div>

			{
				images.length > 0 ? (
					<>
						<div class="grid grid-cols-2 sm:grid-cols-3 gap-3" role="list" aria-label="Галерея" id="gallery-grid-full">
							{images.map((img, i) => (
								<div
									class="glass-card rounded-xl overflow-hidden aspect-video group cursor-pointer hover:scale-105 transition-transform duration-300 hover:border-accent/30 relative gallery-item-full"
									style="border-color: rgba(74,222,128,0.1);"
									role="listitem"
									title={img.caption}
									data-gallery-index={i}
									data-gallery-src={img.src}
									data-gallery-alt={img.alt}
									data-gallery-caption={img.caption}
								>
									<img
										src={img.src}
										alt={img.alt}
										class="w-full h-full object-cover"
										width="640"
										height="360"
										loading="lazy"
										decoding="async"
									/>
									<div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-3">
										<span class="text-xs text-white/90 leading-tight">{img.caption}</span>
									</div>
								</div>
							))}
						</div>

						{/* Gallery Modal */}
						<div
							id="gallery-modal-full"
							data-open="false"
							class="fixed inset-0 z-50 flex items-center justify-center bg-black/90 p-4 opacity-0 pointer-events-none backdrop-blur-sm transition-opacity data-[open=true]:opacity-100 data-[open=true]:pointer-events-auto"
						>
							<div class="relative flex h-full w-full max-h-screen max-w-6xl flex-col items-center justify-center">
								{/* Close Button */}
								<button
									id="gallery-close-full"
									class="absolute top-4 right-4 text-white/60 hover:text-white transition-colors z-10"
									aria-label="Close gallery"
									type="button"
								>
									<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
										<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
									</svg>
								</button>

								{/* Image */}
								<img
									id="gallery-image-full"
									src=""
									alt=""
									class="max-w-full max-h-[85vh] w-auto h-auto rounded-lg object-contain"
									loading="lazy"
									decoding="async"
								/>

								{/* Caption */}
								<div id="gallery-caption-full" class="mt-4 text-center text-white/70 text-sm max-w-2xl"></div>

								{/* Navigation */}
								<div class="absolute bottom-4 left-0 right-0 flex items-center justify-center gap-4">
									<button
										id="gallery-prev-full"
										class="text-white/60 hover:text-white transition-colors p-2"
										aria-label="Previous image"
										type="button"
									>
										<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
											<path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
										</svg>
									</button>
									<span id="gallery-counter-full" class="text-white/60 text-sm min-w-16 text-center"></span>
									<button
										id="gallery-next-full"
										class="text-white/60 hover:text-white transition-colors p-2"
										aria-label="Next image"
										type="button"
									>
										<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
											<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
										</svg>
									</button>
								</div>
							</div>
						</div>
					</>
				) : (
					<div class="grid grid-cols-2 sm:grid-cols-3 gap-3" role="list" aria-label="Галерея">
						{gradients.map((bg) => (
							<div
								class="glass-card rounded-xl overflow-hidden aspect-video relative"
								style={`border-color: rgba(74,222,128,0.1); background: ${bg};`}
								role="listitem"
							>
								<div class="absolute inset-0 pixel-grid opacity-30"></div>
								<div class="absolute inset-0 flex flex-col items-center justify-center gap-2 p-3">
									<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-accent/25" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
										<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
									</svg>
								</div>
							</div>
						))}
					</div>
					<p class="mt-8 text-center text-textColor/40 text-sm">
						Поки що скріншотів немає. Додай зображення у папку <code class="text-accent/70 bg-white/5 px-1 rounded">src/assets/gallery/</code>.
					</p>
				)
			}
		</div>
	</div>
</LandingLayout>

<script>
	const galleryItems = Array.from(document.querySelectorAll(".gallery-item-full")) as HTMLElement[];
	const modal = document.getElementById("gallery-modal-full");
	const image = document.getElementById("gallery-image-full") as HTMLImageElement;
	const caption = document.getElementById("gallery-caption-full");
	const counter = document.getElementById("gallery-counter-full");
	const closeBtn = document.getElementById("gallery-close-full");
	const prevBtn = document.getElementById("gallery-prev-full");
	const nextBtn = document.getElementById("gallery-next-full");

	let currentIndex = 0;

	function openGallery(index: number) {
		currentIndex = index;
		updateImage();
		modal?.setAttribute("data-open", "true");
		document.body.style.overflow = "hidden";
	}

	function closeGallery() {
		modal?.setAttribute("data-open", "false");
		document.body.style.overflow = "";
	}

	function updateImage() {
		const item = galleryItems[currentIndex];
		if (!item) return;

		const src = item.getAttribute("data-gallery-src");
		const alt = item.getAttribute("data-gallery-alt");
		const captionText = item.getAttribute("data-gallery-caption");

		if (src && image) {
			image.src = src;
			image.alt = alt || "";
		}

		if (caption && captionText) {
			caption.textContent = captionText;
		}

		if (counter) {
			counter.textContent = `${currentIndex + 1} / ${galleryItems.length}`;
		}
	}

	function nextImage() {
		currentIndex = (currentIndex + 1) % galleryItems.length;
		updateImage();
	}

	function prevImage() {
		currentIndex = (currentIndex - 1 + galleryItems.length) % galleryItems.length;
		updateImage();
	}

	// Event listeners
	galleryItems.forEach((item, index) => {
		item.addEventListener("click", () => openGallery(index));
	});

	closeBtn?.addEventListener("click", closeGallery);
	prevBtn?.addEventListener("click", prevImage);
	nextBtn?.addEventListener("click", nextImage);

	// Close on Escape key
	document.addEventListener("keydown", (e) => {
		const isOpen = modal?.getAttribute("data-open") === "true";
		if (e.key === "Escape" && isOpen) {
			closeGallery();
		}
		if (e.key === "ArrowLeft" && isOpen) {
			prevImage();
		}
		if (e.key === "ArrowRight" && isOpen) {
			nextImage();
		}
	});

	// Close on modal click (outside image)
	modal?.addEventListener("click", (e) => {
		if (e.target === modal) {
			closeGallery();
		}
	});
</script>
