---
interface Props {
	title: string;
	date: string;
	description: string;
	reward?: string;
	badge?: string;
	status?: "upcoming" | "active" | "ended";
}

const {
	title,
	date,
	description,
	reward,
	badge,
	status = "upcoming",
} = Astro.props;

type Status = "upcoming" | "active" | "ended";
const statusConfig: Record<Status, { label: string; bg: string; color: string }> = {
	upcoming: { label: "Майбутня",  bg: "rgba(74,222,128,0.12)",  color: "#4ade80" },
	active:   { label: "Активна",   bg: "rgba(163,230,53,0.15)",  color: "#a3e635" },
	ended:    { label: "Завершена", bg: "rgba(100,116,139,0.15)", color: "#94a3b8" },
};
const cfg = statusConfig[status as Status];
---

<div
	class="glass-card rounded-2xl p-5 flex flex-col gap-3 hover:border-accent/30 transition-all duration-300 hover:-translate-y-0.5"
	style="border-color: rgba(74,222,128,0.1);"
>
	<div class="flex items-start justify-between gap-3">
		<div class="flex-1 min-w-0">
			{badge && (
				<span class="inline-block px-2 py-0.5 rounded text-xs font-medium mb-2"
					  style={`background: rgba(163,230,53,0.12); color: #a3e635;`}>
					{badge}
				</span>
			)}
			<h3 class="font-bold text-white text-sm leading-snug">{title}</h3>
		</div>
		<span
			class="shrink-0 text-xs px-2 py-1 rounded-full font-medium"
			style={`background: ${cfg.bg}; color: ${cfg.color};`}
		>
			{cfg.label}
		</span>
	</div>

	<p class="text-xs text-textColor/55 leading-relaxed">{description}</p>

	<div class="flex items-center justify-between mt-1">
		<span class="text-xs text-textColor/40 flex items-center gap-1">
			<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
				<path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
			</svg>
			{date}
		</span>
		{reward && (
			<span class="text-xs text-accent/80 flex items-center gap-1">
				<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
					<path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 0 1 3 3h-15a3 3 0 0 1 3-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 0 1-.982-3.172M9.497 14.25a7.454 7.454 0 0 0 .981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 0 0 7.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M7.73 9.728a6.726 6.726 0 0 0 2.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 0 1 2.916.52 6.003 6.003 0 0 1-5.395 4.972m0 0a6.726 6.726 0 0 1-2.749 1.35m0 0a6.772 6.772 0 0 1-3.044 0" />
				</svg>
				{reward}
			</span>
		)}
	</div>
</div>
