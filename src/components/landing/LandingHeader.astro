---
import { menuLinks } from "@/site-config";

const url = new URL(Astro.request.url);
---

<header
	class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-6 py-3 backdrop-blur-md"
	id="landing-header"
	style="background: rgba(15,23,32,0.85); border-bottom: 1px solid rgba(74,222,128,0.1);"
>
	<!-- Logo -->
	<a href="/" class="flex items-center gap-2 group" aria-label="Pinecraft">
		<img src="/brand/LogoSquare.svg" alt="Pinecraft" class="h-9 w-9" loading="eager" decoding="async" />
		<span class="font-bold text-lg tracking-wide text-white group-hover:text-accent transition-colors">
			Pinecraft
		</span>
	</a>

	<!-- Desktop Nav -->
	<nav aria-label="Main menu" class="hidden md:flex items-center gap-1" id="landing-nav">
		{
			menuLinks.map((link) => {
				const isJoin = link.title === "Грати";
				const isActive = url.pathname === link.path || url.pathname.startsWith(link.path === "/" ? "/xz" : link.path);
				return (
					<a
						href={link.path}
						aria-current={isActive ? "page" : false}
						class:list={[
							"px-3 py-1.5 rounded-lg text-sm font-medium transition-all duration-200",
							isJoin
								? "bg-accent text-[#0f1720] hover:bg-accent/80 font-bold ml-2"
								: "text-textColor/80 hover:text-accent hover:bg-white/5",
							isActive && !isJoin ? "text-accent" : "",
						]}
					>
						{link.title}
					</a>
				);
			})
		}
	</nav>

	<!-- Mobile burger -->
	<button
		aria-expanded="false"
		aria-haspopup="menu"
		aria-label="Open main menu"
		class="md:hidden flex flex-col gap-1.5 p-2"
		id="mobile-menu-btn"
		type="button"
	>
		<span class="block w-6 h-0.5 bg-textColor transition-all" id="burger-1"></span>
		<span class="block w-6 h-0.5 bg-textColor transition-all" id="burger-2"></span>
		<span class="block w-6 h-0.5 bg-textColor transition-all" id="burger-3"></span>
	</button>

	<!-- Mobile menu -->
	<div
		class="md:hidden absolute top-full left-0 right-0 hidden flex-col py-4 px-6 gap-2"
		id="mobile-menu"
		style="background: rgba(15,23,32,0.97); border-bottom: 1px solid rgba(74,222,128,0.1);"
	>
		{
			menuLinks.map((link) => {
				const isJoin = link.title === "Join";
				return (
					<a
						href={link.path}
						class:list={[
							"py-2 px-3 rounded-lg text-sm font-medium transition-colors",
							isJoin
								? "bg-accent text-[#0f1720] font-bold text-center mt-2"
								: "text-textColor hover:text-accent",
						]}
					>
						{link.title}
					</a>
				);
			})
		}
	</div>
</header>

<script>
	const btn = document.getElementById("mobile-menu-btn")!;
	const menu = document.getElementById("mobile-menu")!;
	btn.addEventListener("click", () => {
		const isOpen = btn.getAttribute("aria-expanded") === "true";
		btn.setAttribute("aria-expanded", String(!isOpen));
		menu.classList.toggle("hidden");
		menu.classList.toggle("flex");
	});
</script>
