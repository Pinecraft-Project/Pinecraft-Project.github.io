---
import { getCollection } from "astro:content";
import LandingLayout from "@/layouts/Landing.astro";
import type { EventEntry } from "@/types";

const allEvents = (await getCollection("event")) as EventEntry[];

type Status = "upcoming" | "active" | "ended";
const statusOrder: Record<Status, number> = { active: 0, upcoming: 1, ended: 2 };
const sorted = allEvents.sort(
	(a, b) => statusOrder[a.data.status as Status] - statusOrder[b.data.status as Status],
);

const statusConfig: Record<Status, { label: string; bg: string; color: string }> = {
	upcoming: { label: "Майбутня",  bg: "rgba(74,222,128,0.12)",  color: "#4ade80" },
	active:   { label: "Активна",   bg: "rgba(163,230,53,0.15)",  color: "#a3e635" },
	ended:    { label: "Завершена", bg: "rgba(100,116,139,0.15)", color: "#94a3b8" },
};
---

<LandingLayout meta={{ title: "Події — Pinecraft", description: "Сезонні змагання, війни та фестивалі спільноти Pinecraft." }}>
	<div class="pt-24 pb-20 px-6 min-h-screen">
		<div class="max-w-6xl mx-auto">
			<div class="mb-12">
				<h1 class="text-4xl font-bold text-white mb-3">Події</h1>
				<p class="text-textColor/60">
					Сезонні змагання, війни та фестивалі спільноти. Усі події оголошуються спочатку в
					<a href="https://discord.pinecraft.top/" target="_blank" rel="noopener" class="text-accent hover:underline">Discord</a>.
				</p>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
				{
					sorted.map((ev) => {
						const cfg = statusConfig[ev.data.status as Status];
						return (
							<a
								href={`/events/${ev.slug}/`}
								class="glass-card rounded-2xl p-5 flex flex-col gap-3 hover:border-accent/30 transition-all duration-300 hover:-translate-y-0.5 group"
								style="border-color: rgba(74,222,128,0.1);"
							>
								<div class="flex items-start justify-between gap-3">
									<div class="flex-1 min-w-0">
										{ev.data.badge && (
											<span class="inline-block px-2 py-0.5 rounded text-xs font-medium mb-2" style="background: rgba(163,230,53,0.12); color: #a3e635;">
												{ev.data.badge}
											</span>
										)}
										<h3 class="font-bold text-white text-sm leading-snug group-hover:text-accent transition-colors">
											{ev.data.title}
										</h3>
									</div>
									<span class="shrink-0 text-xs px-2 py-1 rounded-full font-medium" style={`background: ${cfg.bg}; color: ${cfg.color};`}>
										{cfg.label}
									</span>
								</div>
								<p class="text-xs text-textColor/55 leading-relaxed">{ev.data.description}</p>
								<div class="flex items-center justify-between mt-1">
									<span class="text-xs text-textColor/40">{ev.data.date}</span>
									{ev.data.reward && (
										<span class="text-xs text-accent/70">🏆 {ev.data.reward}</span>
									)}
								</div>
							</a>
						);
					})
				}
			</div>
		</div>
	</div>
</LandingLayout>

