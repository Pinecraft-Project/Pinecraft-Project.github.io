---
import mapPreview from "@/assets/images/map-preview.png";
import { siteConfig } from "@/site-config";

interface Props {
	src?: string;
	title?: string;
	interactive?: boolean;
	previewHref?: string;
}
const {
	src = siteConfig.server.mapUrl,
	title = "Pinecraft Live Map",
	interactive = false,
	previewHref = "/map/",
} = Astro.props;
---

<div
	class="glass-card rounded-2xl overflow-hidden relative w-full max-w-full min-w-0 group"
	style="border-color: rgba(74,222,128,0.15); aspect-ratio: 16/9; min-height: clamp(260px, 55vw, 340px);"
>
	{
		interactive ? (
			<>
				<button
					id="map-preview-trigger"
					type="button"
					class="absolute inset-0 block w-full h-full text-left"
					aria-label="Завантажити живу карту"
				>
					<img
						src={mapPreview.src}
						alt={title}
						class="absolute inset-0 w-full h-full object-cover"
						width={mapPreview.width}
						height={mapPreview.height}
						loading="eager"
						decoding="async"
					/>
					<div class="absolute inset-0 bg-black/25 hover:bg-black/15 transition-colors"></div>
					<div class="absolute inset-0 flex items-center justify-center p-6">
						<span class="rounded-lg border border-accent/30 bg-[#071820]/80 px-4 py-2 text-sm font-medium text-white">
							Натисни, щоб завантажити карту
						</span>
					</div>
				</button>

				<iframe
					data-map-src={src}
					title={title}
					allow="fullscreen"
					loading="lazy"
					class="absolute inset-0 hidden w-full h-full border-0"
					id="map-iframe"
				></iframe>
			</>
		) : (
			<a href={previewHref} class="absolute inset-0 block" aria-label="Відкрити сторінку карти">
				<img
					src={mapPreview.src}
					alt={title}
					class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.01]"
					width={mapPreview.width}
					height={mapPreview.height}
					loading="eager"
					decoding="async"
				/>
			</a>
		)
	}
</div>

<script>
	const trigger = document.getElementById("map-preview-trigger") as HTMLButtonElement | null;
	const iframe = document.getElementById("map-iframe") as HTMLIFrameElement | null;

	if (trigger && iframe) {
		trigger.addEventListener("click", () => {
			const src = iframe.dataset.mapSrc;
			if (!src) return;

			iframe.src = src;
			iframe.classList.remove("hidden");
			trigger.classList.add("hidden");
		});
	}
</script>
