---
import GalleryGrid from "@/components/landing/GalleryGrid.astro";
import { getGalleryItems } from "@/data/gallery";
import LandingLayout from "@/layouts/Landing.astro";
import { siteConfig } from "@/site-config";

const images = getGalleryItems();
---

<LandingLayout meta={{ title: "Галерея — Pinecraft", description: "Скріншоти спільноти Pinecraft з усього ігрового світу." }}>
	<div class="pt-24 pb-20 px-6 min-h-screen">
		<div class="max-w-6xl mx-auto">
			<div class="mb-12">
				<h1 class="text-4xl font-bold text-white mb-3">Галерея</h1>
				<p class="text-textColor/60 max-w-xl">
					Скріншоти спільноти з усього світу. Надішли свій у
					<a href={siteConfig.server.discordUrl} target="_blank" rel="noopener" class="text-accent hover:underline">#screenshots</a>
					у Discord.
				</p>
			</div>

			{
				images.length > 0 ? (
					<GalleryGrid items={images} />
				) : (
					<p class="mt-8 text-center text-textColor/40 text-sm">
						Поки що скріншотів немає. Додай зображення у папку <span class="text-accent/70 bg-white/5 px-1 rounded">src/assets/gallery/</span>.
					</p>
				)
			}
		</div>
	</div>
</LandingLayout>
