---
import { getCollection } from "astro:content";
import FeatureCard from "@/components/landing/FeatureCard.astro";
import GalleryGrid from "@/components/landing/GalleryGrid.astro";
import Hero from "@/components/landing/Hero.astro";
import MapEmbed from "@/components/landing/MapEmbed.astro";
import NewsCard from "@/components/landing/NewsCard.astro";
import Section from "@/components/landing/Section.astro";
import ServerStatus from "@/components/landing/ServerStatus.astro";
import { getGalleryItems } from "@/data/gallery";
import { aboutFeatureCards, getHeroEvents, getHeroPosts, landingContent } from "@/data/landing";
import { getAllPosts } from "@/data/post";
import LandingLayout from "@/layouts/Landing.astro";
import { siteConfig } from "@/site-config";
import type { EventEntry } from "@/types";

const allPosts = await getAllPosts();
const latestPosts = getHeroPosts(allPosts, 3);

const allEvents = (await getCollection("event")) as EventEntry[];
type Status = "upcoming" | "active" | "ended";
const latestEvents = getHeroEvents(allEvents, 3);
const galleryItems = getGalleryItems().slice(0, 6);

const statusConfig: Record<Status, { label: string; bg: string; color: string }> = {
	upcoming: { label: "Майбутня", bg: "rgba(74,222,128,0.12)", color: "#4ade80" },
	active: { label: "Активна", bg: "rgba(163,230,53,0.15)", color: "#a3e635" },
	ended: { label: "Завершена", bg: "rgba(100,116,139,0.15)", color: "#94a3b8" },
};
---

<LandingLayout meta={{ title: landingContent.metaTitle }}>
	<!-- Hero -->
	<Hero />

	<!-- About / Features -->
	<Section
		id="about"
		title={landingContent.about.title}
		subtitle={landingContent.about.subtitle}
		class="bg-bgColor"
	>
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
			{aboutFeatureCards.map((f) => <FeatureCard {...f} />)}
		</div>
	</Section>

	<!-- Server Monitoring -->
	<Section
		id="status"
		title={landingContent.status.title}
		subtitle={landingContent.status.subtitle}
		class=""
		style="background: linear-gradient(180deg, #0f1720 0%, #091a0e 100%);"
	>
		<div class="flex justify-center">
			<ServerStatus />
		</div>
	</Section>

	<!-- Map Preview -->
	<Section
		id="map"
		title={landingContent.map.title}
		subtitle={landingContent.map.subtitle}
		class="bg-bgColor"
	>
		<MapEmbed />
		<div class="mt-6 text-center">
			<a
				href="/map/"
				class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl border border-accent/25 text-accent text-sm hover:bg-accent/5 hover:border-accent/50 transition-all"
			>
				{landingContent.map.ctaLabel}
				<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
				</svg>
			</a>
		</div>
	</Section>

	<!-- Events (from collection) -->
	<Section
		id="events"
		title={landingContent.events.title}
		subtitle={landingContent.events.subtitle}
		style="background: linear-gradient(180deg, #091a0e 0%, #0f1720 100%);"
	>
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
			{
				latestEvents.map((ev) => {
					const cfg = statusConfig[ev.data.status as Status];
					return (
						<a
							href={`/events/${ev.slug}/`}
							class="glass-card rounded-2xl p-5 flex flex-col gap-3 hover:border-accent/30 transition-all duration-300 hover:-translate-y-0.5 group"
							style="border-color: rgba(74,222,128,0.1);"
						>
							{ev.data.imageUrl && (
								<div class="overflow-hidden rounded-xl border border-white/10 bg-white/5">
									<img
										src={ev.data.imageUrl}
										alt={ev.data.title}
										class="w-full aspect-square object-cover"
										loading="lazy"
										decoding="async"
										referrerpolicy="no-referrer"
									/>
								</div>
							)}
							<div class="flex items-start justify-between gap-3">
								<div class="flex-1 min-w-0">
									{ev.data.badge && (
										<span class="inline-block px-2 py-0.5 rounded text-xs font-medium mb-2" style="background: rgba(163,230,53,0.12); color: #a3e635;">
											{ev.data.badge}
										</span>
									)}
									<h3 class="font-bold text-white text-sm leading-snug group-hover:text-accent transition-colors">
										{ev.data.title}
									</h3>
								</div>
								<span class="shrink-0 text-xs px-2 py-1 rounded-full font-medium" style={`background: ${cfg.bg}; color: ${cfg.color};`}>
									{cfg.label}
								</span>
							</div>
							<p class="text-xs text-textColor/55 leading-relaxed">{ev.data.description}</p>
							<div class="flex items-center justify-between mt-1">
								<span class="text-xs text-textColor/40">{ev.data.date}</span>
								<span class="text-xs text-accent/60">Детальніше →</span>
							</div>
						</a>
					);
				})
			}
		</div>
		<div class="mt-8 text-center">
			<a href="/events/" class="text-sm text-textColor/50 hover:text-accent transition-colors">
				Усі події →
			</a>
		</div>
	</Section>

	<!-- News -->
	<Section
		id="news"
		title={landingContent.news.title}
		subtitle={landingContent.news.subtitle}
		class="bg-bgColor"
	>
		{
			latestPosts.length > 0 ? (
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
					{latestPosts.map((post) => <NewsCard post={post} />)}
				</div>
			) : (
				<div class="text-center py-12 text-textColor/40 text-sm">
					<p>{landingContent.news.emptyText}</p>
				</div>
			)
		}
		<div class="mt-8 text-center">
			<a href="/news/" class="text-sm text-textColor/50 hover:text-accent transition-colors">
				Усі новини →
			</a>
		</div>
	</Section>

	<!-- Gallery -->
	<Section
		id="gallery"
		title={landingContent.gallery.title}
		subtitle={landingContent.gallery.subtitle}
		style="background: linear-gradient(180deg, #0f1720 0%, #091a0e 100%);"
	>
		<GalleryGrid items={galleryItems} />
		<div class="mt-8 text-center">
			<a href="/gallery/" class="text-sm text-textColor/50 hover:text-accent transition-colors">
				{landingContent.gallery.ctaLabel}
			</a>
		</div>
	</Section>

	<!-- Discord CTA -->
	<section
		id="join-guide"
		class="py-24 px-6 text-center relative overflow-hidden"
		style="background: linear-gradient(135deg, #071820 0%, #061a0e 100%);"
	>
		<div class="absolute inset-0 pixel-grid opacity-20"></div>
		<div
			class="absolute inset-0 opacity-20"
			style="background: radial-gradient(ellipse at center, rgba(74,222,128,0.25) 0%, transparent 65%);"
		></div>
		<div class="relative z-10 max-w-2xl mx-auto">
<h2 class="text-3xl md:text-5xl font-bold text-white mb-4">{landingContent.join.title}</h2>
		<p class="text-textColor/60 text-base mb-8">
			{landingContent.join.subtitle}
			</p>

			<div class="flex flex-col sm:flex-row gap-4 justify-center mb-10">
				<div class="glass-card rounded-xl px-5 py-3 flex items-center gap-3 max-w-xs mx-auto sm:mx-0"
					 style="border-color: rgba(74,222,128,0.2);">
					<span class="text-xs text-textColor/50">{landingContent.join.compatibilityLabel}</span>
					<span class="text-accent font-mono font-bold text-sm">{landingContent.join.serverAddress}</span>
				</div>
			</div>

			<a
				href={siteConfig.server.discordUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-3 px-8 py-3.5 rounded-xl font-bold bg-[#5865F2] text-white hover:bg-[#4752c4] transition-all duration-200 shadow-lg hover:scale-105"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
					<path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.001.022.015.043.032.054a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/>
				</svg>
			{landingContent.join.discordLabel}
			</a>
		</div>
	</section>
</LandingLayout>

