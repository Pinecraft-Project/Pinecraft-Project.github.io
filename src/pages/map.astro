---
import MapEmbed from "@/components/landing/MapEmbed.astro";
import LandingLayout from "@/layouts/Landing.astro";
---

<LandingLayout meta={{ title: "Карта Світу — Pinecraft" }}>
	<div class="pt-24 pb-20 px-6 min-h-screen">
		<div class="max-w-6xl mx-auto">
			<div class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
				<div>
					<h1 class="text-4xl font-bold text-white mb-3">Карта Світу</h1>
					<p class="text-textColor/60 text-sm">
						Жива BlueMap світу Pinecraft. Оновлюється кожні 20 секунд.
					</p>
				</div>
				<a
					href="https://map.pinecraft.top"
					target="_blank"
					rel="noopener noreferrer"
					class="shrink-0 inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-accent/25 text-accent text-sm hover:bg-accent/5 hover:border-accent/50 transition-all"
				>
					Відкрити повну карту
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
					</svg>
				</a>
			</div>

			<div class="w-full overflow-hidden" style="height: min(70vh, 800px); min-height: 320px;">
				<MapEmbed />
			</div>

			<!-- Legend -->
			<div class="mt-8 glass-card rounded-2xl p-6" style="border-color: rgba(74,222,128,0.1);">
				<h2 class="text-sm font-bold text-white mb-4">Легенда карти</h2>
				<div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs text-textColor/60">
					<div class="flex items-center gap-2">
						<span class="w-3 h-3 rounded-full bg-accent inline-block"></span>Спаун міста
					</div>
					<div class="flex items-center gap-2">
						<span class="w-3 h-3 rounded-full bg-yellow-400 inline-block"></span>Точка інтересу
					</div>
					<div class="flex items-center gap-2">
						<span class="w-3 h-3 rounded-full bg-red-400 inline-block"></span>Зона бою
					</div>
					<div class="flex items-center gap-2">
						<span class="w-3 h-3 rounded-full bg-blue-400 inline-block"></span>Кордон нації
					</div>
				</div>
			</div>
		</div>
	</div>
</LandingLayout>
